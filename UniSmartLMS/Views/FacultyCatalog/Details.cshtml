@model UniSmartLMS.Models.SectionC_Catalog.ItemCopy
@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Book Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Title</dt>
                                <dd>@Model.ItemInfo?.Title</dd>
                                <dt>Author</dt>
                                <dd>@(Model.ItemInfo?.AuthorItemInfos?.FirstOrDefault()?.Author?.Name ?? "N/A")</dd>
                                <dt>ISBN</dt>
                                <dd>@Model.ItemInfo?.ISBN</dd>
                                <dt>Publisher</dt>
                                <dd>@Model.ItemInfo?.PublisherInfo?.Name</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Branch</dt>
                                <dd>@Model.LibraryBranch?.Name</dd>
                                <dt>Section</dt>
                                <dd>@Model.LibraryRack?.LibraryItemSection?.Name</dd>
                                <dt>Rack (الماری)</dt>
                                <dd>@Model.LibraryRack?.Code</dd>
                                <dt>Shelf (ڈبہ)</dt>
                                <dd>@Model.LibraryShelf?.Code</dd>
                                <dt>Barcode</dt>
                                <dd><code>@Model.Barcode</code></dd>
                                <dt>Accession No</dt>
                                <dd>@Model.AccessionNumber</dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end">
                        <a asp-action="Books" class="btn btn-outline-secondary">Back to Catalog</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
