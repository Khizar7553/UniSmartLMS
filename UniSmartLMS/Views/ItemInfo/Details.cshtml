@model UniSmartLMS.Models.SectionC_Catalog.ItemInfo

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Book Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Title</dt>
                                <dd>@Model.Title</dd>

                                <dt>ISBN</dt>
                                <dd>@Model.ISBN</dd>

                                <dt>Subject</dt>
                                <dd>@Model.SubjectHeading?.Name</dd>

                                <dt>Language</dt>
                                <dd>@Model.Language?.LanguageCategory</dd>

                                <dt>Publisher</dt>
                                <dd>@Model.PublisherInfo?.Name</dd>

                                <dt>Publish Date</dt>
                                <dd>@Model.PublishDate?.ToString("dd MMM yyyy")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Total Pages</dt>
                                <dd>@Model.TotalPages</dd>

                                <dt>Binding Type</dt>
                                <dd>@Model.BindingType</dd>

                                <dt>Added to Library</dt>
                                <dd>@(Model.AddedToLibraryDate?.ToString("dd MMM yyyy") ?? Model.CreatedAt.ToString("dd MMM yyyy"))</dd>

                                <dt>Status</dt>
                                <dd>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <hr />
                    <div class="mt-3">
                        <dt>Description</dt>
                        <dd>@Model.Description</dd>

                        <dt>Keywords</dt>
                        <dd>@Model.Keywords</dd>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>