@model UniSmartLMS.Models.SectionC_Catalog.ItemInfo

@{
    ViewData["Title"] = "Add New Book";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add New Book</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Title" class="form-label fw-bold">Title</label>
                                <input asp-for="Title" class="form-control" placeholder="Book title" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="ISBN" class="form-label fw-bold">ISBN</label>
                                <input asp-for="ISBN" class="form-control" placeholder="978-3-16-148410-0" />
                                <span asp-validation-for="ISBN" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SubjectHeadingId" class="form-label fw-bold">Subject</label>
                                <select asp-for="SubjectHeadingId" class="form-control" asp-items="ViewBag.SubjectList">
                                    <option value="">-- Select Subject --</option>
                                </select>
                                <span asp-validation-for="SubjectHeadingId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="LanguageId" class="form-label fw-bold">Language</label>
                                <select asp-for="LanguageId" class="form-control" asp-items="ViewBag.LanguageList">
                                    <option value="">-- Select Language --</option>
                                </select>
                                <span asp-validation-for="LanguageId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="PublisherInfoId" class="form-label fw-bold">Publisher</label>
                                <select asp-for="PublisherInfoId" class="form-control" asp-items="ViewBag.PublisherList">
                                    <option value="">-- Select Publisher --</option>
                                </select>
                                <span asp-validation-for="PublisherInfoId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Multi-Select Authors -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Authors</label>
                            <select name="authorIds" class="form-control" multiple size="5" asp-items="ViewBag.AuthorList">
                                <option value="">-- Select Authors (Ctrl+Click for multiple) --</option>
                            </select>
                            <small class="text-muted">Hold Ctrl to select multiple authors</small>
                        </div>

                        <!-- Edition Section -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Edition Year</label>
                                <input type="number" name="editionYear" class="form-control" placeholder="e.g., 2024" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Edition Number</label>
                                <input type="text" name="editionNumber" class="form-control" placeholder="e.g., 3rd Edition" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="PublishDate" class="form-label fw-bold">Publish Date</label>
                                <input asp-for="PublishDate" type="date" class="form-control" />
                                <span asp-validation-for="PublishDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="TotalPages" class="form-label fw-bold">Total Pages</label>
                                <input asp-for="TotalPages" class="form-control" placeholder="e.g., 350" />
                                <span asp-validation-for="TotalPages" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="BindingType" class="form-label fw-bold">Binding Type</label>
                                <select asp-for="BindingType" class="form-control">
                                    <option value="">-- Select Binding --</option>
                                    <option value="Hardcover">Hardcover</option>
                                    <option value="Paperback">Paperback</option>
                                    <option value="Spiral">Spiral</option>
                                </select>
                                <span asp-validation-for="BindingType" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Book description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Keywords" class="form-label fw-bold">Keywords</label>
                            <input asp-for="Keywords" class="form-control" placeholder="programming, C#, .NET" />
                            <span asp-validation-for="Keywords" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-2"></i>Create Book</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}