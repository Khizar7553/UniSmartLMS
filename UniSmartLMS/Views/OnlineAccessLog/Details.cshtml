@model UniSmartLMS.Models.SectionH_Digital.OnlineAccessLog

@{
    ViewData["Title"] = "Access Log Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Access Log Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Resource ID</dt>
                                <dd>@Model.DigitalResourceId</dd>

                                <dt>Member Card</dt>
                                <dd>@Model.LibraryMember?.CardNo</dd>

                                <dt>Access Date</dt>
                                <dd>@Model.AccessDate.ToString("dd MMM yyyy, hh:mm tt")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Access Type</dt>
                                <dd>
                                    @if (Model.AccessType == "View")
                                    {
                                        <span class="badge bg-info">View</span>
                                    }
                                    else if (Model.AccessType == "Download")
                                    {
                                        <span class="badge bg-success">Download</span>
                                    }
                                    else if (Model.AccessType == "Print")
                                    {
                                        <span class="badge bg-warning text-dark">Print</span>
                                    }
                                    else
                                    {
                                        <span>@Model.AccessType</span>
                                    }
                                </dd>

                                <dt>Status</dt>
                                <dd>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </dd>

                                <dt>Created At</dt>
                                <dd>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>