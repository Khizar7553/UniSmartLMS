@model UniSmartLMS.Models.SectionE_Circulation.CirculationRule

@{
    ViewData["Title"] = "Circulation Rule Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Circulation Rule Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Member Type</dt>
                                <dd>@Model.Party?.PartyName</dd>

                                <dt>Library Branch</dt>
                                <dd>@Model.LibraryBranch?.Description</dd>

                                <dt>Max Current Loans</dt>
                                <dd>@Model.MaxCurrentLoans</dd>

                                <dt>Max Current Reserves</dt>
                                <dd>@Model.MaxCurrentReserves</dd>

                                <dt>Loan Days</dt>
                                <dd>@Model.LoanDays days</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Grace Days</dt>
                                <dd>@Model.GraceDay days</dd>

                                <dt>Max Renewals</dt>
                                <dd>@Model.MaxRenewals</dd>

                                <dt>Overdue Fine/Day</dt>
                                <dd>Rs. @Model.OverdueFinePerDay.ToString("N2")</dd>

                                <dt>Max Fine Per Item</dt>
                                <dd>Rs. @Model.MaxFinePerItem.ToString("N2")</dd>

                                <dt>Damage Value</dt>
                                <dd>Rs. @Model.DamageValue.ToString("N2")</dd>

                                <dt>Lost Charges</dt>
                                <dd>@Model.LostChargesItem</dd>
                            </dl>
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>