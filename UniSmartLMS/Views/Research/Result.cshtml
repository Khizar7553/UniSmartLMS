@{
    ViewData["Title"] = "Research Analysis Results";
    var analysis = ViewBag.Analysis as UniSmartLMS.Services.ResearchAnalysis;
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- File Info Banner -->
    <div class="card bg-dark text-white mb-4 border-0 rounded-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h3 class="mb-1">
                        <i class="fas fa-file-alt me-2"></i>@ViewBag.Title
                    </h3>
                    <p class="mb-0 opacity-75">
                        <i class="fas fa-file me-2"></i>@analysis.FileType |
                        <i class="fas fa-file-alt me-2 ms-2"></i>@analysis.WordCount words |
                        <i class="fas fa-file-pdf me-2 ms-2"></i>@analysis.PageCount pages
                    </p>
                </div>
                <div class="col-md-4 text-end">
                    <span class="badge bg-success fs-6 px-3 py-2">
                        <i class="fas fa-robot me-1"></i>AI Analysis Complete
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Objective Card -->
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-lg rounded-4">
                <div class="card-header bg-primary text-white rounded-4 rounded-bottom-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-bullseye me-2"></i>Main Objective</h5>
                </div>
                <div class="card-body p-4">
                    <p class="mb-0 fs-5">@analysis.MainObjective</p>
                </div>
            </div>
        </div>

        <!-- Methodology Card -->
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-lg rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-microscope me-2"></i>Methodology</h5>
                </div>
                <div class="card-body p-4">
                    <p class="mb-0 fs-5">@analysis.Methodology</p>
                </div>
            </div>
        </div>

        <!-- Key Findings Card -->
        <div class="col-md-12">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-success text-white rounded-4 rounded-bottom-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-check-double me-2"></i>Key Findings</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        @foreach (var finding in analysis.KeyFindings)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="d-flex">
                                    <i class="fas fa-check-circle text-success mt-1 me-3 fs-5"></i>
                                    <p class="mb-0">@finding</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Conclusion & Keywords Row -->
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-warning text-dark rounded-4 rounded-bottom-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-flag-checkered me-2"></i>Conclusion</h5>
                </div>
                <div class="card-body p-4">
                    <p class="mb-0 fs-5">@analysis.Conclusion</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-secondary text-white rounded-4 rounded-bottom-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Keywords</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var keyword in analysis.Keywords)
                        {
                            <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                                <i class="fas fa-tag me-1 text-muted"></i>@keyword
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- AI Summary Card -->
        <div class="col-md-12">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-dark text-white rounded-4 rounded-bottom-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-robot me-2"></i>AI Executive Summary</h5>
                </div>
                <div class="card-body p-4">
                    <p class="mb-0 fs-5">@analysis.Summary</p>
                </div>
            </div>
        </div>

        <!-- Citations Section -->
        <div class="col-md-12">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h5 class="mb-0 text-white"><i class="fas fa-quote-right me-2"></i>Generated Citations</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 120px">Style</th>
                                    <th>Citation</th>
                                    <th style="width: 80px">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="badge bg-primary">APA</span></td>
                                    <td><code>@ViewBag.CitationAPA</code></td>
                                    <td><button class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('@ViewBag.CitationAPA')"><i class="fas fa-copy"></i></button></td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-success">MLA</span></td>
                                    <td><code>@ViewBag.CitationMLA</code></td>
                                    <td><button class="btn btn-sm btn-outline-success" onclick="copyToClipboard('@ViewBag.CitationMLA')"><i class="fas fa-copy"></i></button></td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-info">Harvard</span></td>
                                    <td><code>@ViewBag.CitationHarvard</code></td>
                                    <td><button class="btn btn-sm btn-outline-info" onclick="copyToClipboard('@ViewBag.CitationHarvard')"><i class="fas fa-copy"></i></button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-4">
        <div class="col-12 text-center">
            <a asp-action="Index" class="btn btn-outline-primary btn-lg px-4 me-2">
                <i class="fas fa-upload me-2"></i>Analyze Another File
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                <i class="fas fa-tachometer-alt me-2"></i>Go to Dashboard
            </a>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            alert('✅ Citation copied to clipboard!');
        });
    }
</script>