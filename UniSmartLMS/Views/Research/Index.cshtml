@{
    ViewData["Title"] = "Research Assistant";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient text-white text-center rounded-4 rounded-bottom-0 py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h2 class="mb-0">
                        <i class="fas fa-robot me-2"></i>AI Research Assistant
                    </h2>
                    <p class="mb-0 small opacity-75 mt-1">Upload any document - Get AI-powered structured analysis</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Analyze" method="post" enctype="multipart/form-data">
                        <div class="text-center mb-4">
                            <i class="fas fa-file-alt fa-5x text-primary mb-3"></i>
                            <h4>Upload Your Research Document</h4>
                            <p class="text-muted">AI extracts objective, methodology, findings, conclusion, and citations</p>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Select File</label>
                            <input type="file" name="file" class="form-control form-control-lg" accept=".pdf,.doc,.docx,.ppt,.pptx,.txt" required />
                            <small class="text-muted">Supported: PDF, DOC, DOCX, PPT, PPTX, TXT | Max size: 15MB</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Citation Style</label>
                            <select name="citationStyle" class="form-select form-select-lg">
                                <option value="APA">📚 APA (American Psychological Association)</option>
                                <option value="MLA">📖 MLA (Modern Language Association)</option>
                                <option value="Harvard">🎓 Harvard</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 py-3">
                            <i class="fas fa-magic me-2"></i>Analyze Document
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>