@model UniSmartLMS.Models.SectionF_Fines.FineDefinition

@{
    ViewData["Title"] = "Edit Fine Definition";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Fine Definition</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ItemCopyId" class="form-label fw-bold">Book Copy</label>
                                <select asp-for="ItemCopyId" class="form-control" asp-items="ViewBag.CopyList">
                                    <option value="">-- Select Book Copy --</option>
                                </select>
                                <span asp-validation-for="ItemCopyId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FineCategoryId" class="form-label fw-bold">Fine Category</label>
                                <select asp-for="FineCategoryId" class="form-control" asp-items="ViewBag.CategoryList">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="FineCategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FineConditionId" class="form-label fw-bold">Fine Condition ID</label>
                            <input asp-for="FineConditionId" class="form-control" />
                            <span asp-validation-for="FineConditionId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-warning px-4"><i class="fas fa-save me-2"></i>Save</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
