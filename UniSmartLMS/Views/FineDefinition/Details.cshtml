@model UniSmartLMS.Models.SectionF_Fines.FineDefinition

@{
    ViewData["Title"] = "Fine Definition Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Fine Definition Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>ID</dt>
                                <dd>@Model.Id</dd>

                                <dt>Book Barcode</dt>
                                <dd>@Model.ItemCopy?.Barcode</dd>

                                <dt>Fine Category</dt>
                                <dd>@Model.FineCategory?.FineCategoryName</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Fine Condition ID</dt>
                                <dd>@Model.FineConditionId</dd>

                                <dt>Status</dt>
                                <dd>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </dd>

                                <dt>Created At</dt>
                                <dd>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>