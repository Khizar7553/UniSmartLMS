@model UniSmartLMS.Models.SectionF_Fines.FineTransaction

@{
    ViewData["Title"] = "Fine Transaction Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Transaction Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Fine Allocation Date</dt>
                                <dd>@Model.FineAllocationDate.ToString("dd MMM yyyy")</dd>

                                <dt>Library Branch</dt>
                                <dd>@Model.LibraryBranch?.Description</dd>

                                <dt>Reason</dt>
                                <dd>@Model.Reason</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Amount</dt>
                                <dd>Rs. @Model.Amount.ToString("N2")</dd>

                                <dt>Paid On</dt>
                                <dd>@Model.PaidOn.ToString("dd MMM yyyy")</dd>

                                <dt>Payment Reference</dt>
                                <dd>@Model.PaymentRef</dd>

                                <dt>Bank Account</dt>
                                <dd>@Model.BankAccount</dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>