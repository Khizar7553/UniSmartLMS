@model UniSmartLMS.Models.SectionF_Fines.FineTransaction

@{
    ViewData["Title"] = "Create Fine Transaction";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Record Fine Payment</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="LibraryBranchId" class="form-label fw-bold">Library Branch</label>
                                <select asp-for="LibraryBranchId" class="form-control" asp-items="ViewBag.BranchList">
                                    <option value="">-- Select Branch --</option>
                                </select>
                                <span asp-validation-for="LibraryBranchId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FineAllocationDate" class="form-label fw-bold">Fine Allocation Date</label>
                                <input asp-for="FineAllocationDate" type="date" class="form-control" />
                                <span asp-validation-for="FineAllocationDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Reason" class="form-label fw-bold">Reason</label>
                                <select asp-for="Reason" class="form-control">
                                    <option value="">-- Select Reason --</option>
                                    <option value="Overdue">Overdue Fine</option>
                                    <option value="Lost Book">Lost Book</option>
                                    <option value="Damaged Book">Damaged Book</option>
                                    <option value="Processing Fee">Processing Fee</option>
                                </select>
                                <span asp-validation-for="Reason" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Amount" class="form-label fw-bold">Amount (Rs.)</label>
                                <input asp-for="Amount" class="form-control" placeholder="e.g., 500" />
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PaidOn" class="form-label fw-bold">Paid On</label>
                                <input asp-for="PaidOn" type="date" class="form-control" />
                                <span asp-validation-for="PaidOn" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PaymentRef" class="form-label fw-bold">Payment Reference</label>
                                <input asp-for="PaymentRef" class="form-control" placeholder="e.g., Receipt #001" />
                                <span asp-validation-for="PaymentRef" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BankAccount" class="form-label fw-bold">Bank Account</label>
                            <input asp-for="BankAccount" class="form-control" placeholder="e.g., HBL-123456789" />
                            <span asp-validation-for="BankAccount" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-2"></i>Record Payment</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}