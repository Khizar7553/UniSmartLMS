@model UniSmartLMS.Models.SectionD_People.MemberQuotaOverride

@{
    ViewData["Title"] = "Quota Override Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Quota Override Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Member Card</dt>
                                <dd>@Model.LibraryMember?.CardNo</dd>

                                <dt>Member Name</dt>
                                <dd>@Model.LibraryMember?.Party?.PartyName</dd>

                                <dt>Library Branch</dt>
                                <dd>@Model.LibraryBranch?.Description</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Status</dt>
                                <dd>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </dd>

                                <dt>Created At</dt>
                                <dd>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
                            </dl>
                        </div>
                    </div>

                    <hr />
                    <h5 class="fw-bold">Borrowing Limits</h5>
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-primary">@Model.MaxCurrentLoans</h3>
                                    <p class="mb-0">Max Loans</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-primary">@Model.MaxCurrentReserves</h3>
                                    <p class="mb-0">Max Reserves</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-primary">@Model.LoanDays</h3>
                                    <p class="mb-0">Loan Days</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-warning">@Model.GraceDay</h3>
                                    <p class="mb-0">Grace Days</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-warning">@Model.MaxRenewals</h3>
                                    <p class="mb-0">Max Renewals</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />
                    <h5 class="fw-bold">Fine Settings</h5>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h4 class="text-danger">Rs. @Model.OverdueFinePerDay.ToString("N2")</h4>
                                    <p class="mb-0">Fine per Day (Overdue)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h4 class="text-danger">Rs. @Model.MaxFinePerItem.ToString("N2")</h4>
                                    <p class="mb-0">Maximum Fine per Item</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>