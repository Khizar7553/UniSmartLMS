@model IEnumerable<UniSmartLMS.Models.SectionD_People.MemberQuotaOverride>

@{
    ViewData["Title"] = "Member Quota Overrides";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-primary">
                <i class="fas fa-chart-line me-3"></i>Member Quota Overrides
            </h1>
            <p class="text-muted">Custom borrowing limits for specific members</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow">
            <i class="fas fa-plus-circle me-2"></i>Add Override
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-4 rounded-bottom-0">
            <i class="fas fa-list me-2"></i> Quota Overrides List
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Card No.</th>
                            <th>Member Name</th>
                            <th>Branch</th>
                            <th>Max Loans</th>
                            <th>Max Reserves</th>
                            <th>Loan Days</th>
                            <th>Fine/Day (Rs.)</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">@item.LibraryMember?.CardNo</td>
                                <td class="fw-bold">@item.LibraryMember?.Party?.PartyName</td>
                                <td>@item.LibraryBranch?.Description</td>
                                <td><span class="badge bg-info">@item.MaxCurrentLoans</span></td>
                                <td><span class="badge bg-info">@item.MaxCurrentReserves</span></td>
                                <td><span class="badge bg-info">@item.LoanDays</span></td>
                                <td><span class="badge bg-warning">@item.OverdueFinePerDay.ToString("N2")</span></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash-alt"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>