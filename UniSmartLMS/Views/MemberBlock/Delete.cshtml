@model UniSmartLMS.Models.SectionD_People.MemberBlock

@{
    ViewData["Title"] = "Unblock Member";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 border-success">
                <div class="card-header bg-success text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-check-circle me-2"></i>Unblock Member</h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Confirmation:</strong> Are you sure you want to unblock this member?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Member Card</dt>
                        <dd class="col-sm-8">@Model.LibraryMember?.CardNo</dd>

                        <dt class="col-sm-4">Member Name</dt>
                        <dd class="col-sm-8">@Model.LibraryMember?.Party?.PartyName</dd>

                        <dt class="col-sm-4">Reason</dt>
                        <dd class="col-sm-8">@Model.Reason</dd>

                        <dt class="col-sm-4">Block Period</dt>
                        <dd class="col-sm-8">@Model.ActiveFrom.ToString("dd MMM yyyy") - @(Model.ActiveTo?.ToString("dd MMM yyyy") ?? "Permanent")</dd>
                    </dl>

                    <hr />
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success px-4"><i class="fas fa-unlock-alt me-2"></i>Confirm Unblock</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>