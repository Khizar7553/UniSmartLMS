@model IEnumerable<UniSmartLMS.Models.SectionD_People.MemberBlock>

@{
    ViewData["Title"] = "Member Blocks";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-danger">
                <i class="fas fa-ban me-3"></i>Member Blocks
            </h1>
            <p class="text-muted">Manage blocked library members</p>
        </div>
        <a asp-action="Create" class="btn btn-danger btn-lg shadow">
            <i class="fas fa-plus-circle me-2"></i>Block Member
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Box -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Search" method="get" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control form-control-lg"
                           placeholder="Search by reason..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-danger text-white rounded-4 rounded-bottom-0">
            <i class="fas fa-list me-2"></i> Blocked Members List
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Card No.</th>
                            <th>Member Name</th>
                            <th>Branch</th>
                            <th>Reason</th>
                            <th>Active From</th>
                            <th>Active To</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.LibraryMember?.CardNo</td>
                                <td class="fw-bold">@item.LibraryMember?.Party?.PartyName</td>
                                <td>@item.LibraryBranch?.Description</td>
                                <td>@item.Reason</td>
                                <td>@item.ActiveFrom.ToString("dd MMM yyyy")</td>
                                <td>@(item.ActiveTo?.ToString("dd MMM yyyy") ?? "Permanent")</td>
                                <td>
                                    @if (item.IsActive && (item.ActiveTo == null || item.ActiveTo > DateTime.Now))
                                    {
                                        <span class="badge bg-danger rounded-pill">Blocked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill">Expired</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash-alt"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>