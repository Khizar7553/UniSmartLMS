@model UniSmartLMS.Models.SectionD_People.MemberBlock

@{
    ViewData["Title"] = "Member Block Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Block Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Member Card</dt>
                                <dd>@Model.LibraryMember?.CardNo</dd>

                                <dt>Member Name</dt>
                                <dd>@Model.LibraryMember?.Party?.PartyName</dd>

                                <dt>Library Branch</dt>
                                <dd>@Model.LibraryBranch?.Description</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Reason</dt>
                                <dd><span class="badge bg-danger">@Model.Reason</span></dd>

                                <dt>Block Start</dt>
                                <dd>@Model.ActiveFrom.ToString("dd MMM yyyy")</dd>

                                <dt>Block End</dt>
                                <dd>@(Model.ActiveTo?.ToString("dd MMM yyyy") ?? "Permanent")</dd>

                                <dt>Status</dt>
                                <dd>
                                    @if (Model.IsActive && (Model.ActiveTo == null || Model.ActiveTo > DateTime.Now))
                                    {
                                        <span class="badge bg-danger">Active Block</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Expired</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>