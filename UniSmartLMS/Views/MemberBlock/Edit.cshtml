@model UniSmartLMS.Models.SectionD_People.MemberBlock

@{
    ViewData["Title"] = "Edit Member Block";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Member Block</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="LibraryMemberId" class="form-label fw-bold">Member</label>
                                <select asp-for="LibraryMemberId" class="form-control" asp-items="ViewBag.MemberList">
                                    <option value="">-- Select Member --</option>
                                </select>
                                <span asp-validation-for="LibraryMemberId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LibraryBranchId" class="form-label fw-bold">Library Branch</label>
                                <select asp-for="LibraryBranchId" class="form-control" asp-items="ViewBag.BranchList">
                                    <option value="">-- Select Branch --</option>
                                </select>
                                <span asp-validation-for="LibraryBranchId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label fw-bold">Reason</label>
                            <select asp-for="Reason" class="form-control">
                                <option value="">-- Select Reason --</option>
                                <option value="Overdue Books">Overdue Books</option>
                                <option value="Lost Books">Lost Books</option>
                                <option value="Damaged Books">Damaged Books</option>
                                <option value="Misconduct">Misconduct</option>
                                <option value="Policy Violation">Policy Violation</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ActiveFrom" class="form-label fw-bold">Start Date</label>
                                <input asp-for="ActiveFrom" type="date" class="form-control" />
                                <span asp-validation-for="ActiveFrom" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ActiveTo" class="form-label fw-bold">End Date</label>
                                <input asp-for="ActiveTo" type="date" class="form-control" />
                                <span asp-validation-for="ActiveTo" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active Block</label>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-warning px-4"><i class="fas fa-save me-2"></i>Save</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}