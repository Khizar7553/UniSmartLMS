@model UniSmartLMS.Models.SectionG_Acquisitions.ItemQuotation

@{
    ViewData["Title"] = "Edit Item Quotation";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Quotation</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PartyId" class="form-label fw-bold">Vendor / Party</label>
                                <select asp-for="PartyId" class="form-control" asp-items="ViewBag.PartyList">
                                    <option value="">-- Select Vendor --</option>
                                </select>
                                <span asp-validation-for="PartyId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LibraryRackId" class="form-label fw-bold">Rack</label>
                                <select asp-for="LibraryRackId" class="form-control" asp-items="ViewBag.RackList">
                                    <option value="">-- Select Rack --</option>
                                </select>
                                <span asp-validation-for="LibraryRackId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="QuotationDate" class="form-label fw-bold">Quotation Date (YYYYMMDD)</label>
                                <input asp-for="QuotationDate" class="form-control" />
                                <span asp-validation-for="QuotationDate" class="text-danger small"></span>
                                <small class="text-muted">Format: 20260502 for 02-May-2026</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Amount" class="form-label fw-bold">Amount</label>
                                <input asp-for="Amount" class="form-control" />
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Discount" class="form-label fw-bold">Discount</label>
                                <input asp-for="Discount" class="form-control" />
                                <span asp-validation-for="Discount" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Net Amount:</strong> <span id="netAmount">@((Model.Amount - Model.Discount).ToString("N2"))</span> Rs.
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-warning px-4"><i class="fas fa-save me-2"></i>Save</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}