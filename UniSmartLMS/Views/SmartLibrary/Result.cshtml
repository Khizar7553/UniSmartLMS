@using UniSmartLMS.Models
@model SearchResult

@{
    ViewData["Title"] = "Search Results";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <!-- Back Button -->
            <a asp-action="Index" class="btn btn-outline-secondary mb-3">
                <i class="fas fa-arrow-left me-2"></i>New Search
            </a>

            <!-- Question Card -->
            <div class="card bg-primary text-white mb-4 border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="mb-0">
                        <i class="fas fa-question-circle me-2"></i>
                        @ViewBag.Query
                    </h5>
                </div>
            </div>

            <!-- Answer Card with Markdown Rendering -->
            <div class="card shadow-lg border-0 rounded-4 mb-4">
                <div class="card-header bg-success text-white rounded-4 rounded-bottom-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-robot me-2"></i>AI Answer
                        <span class="badge bg-light text-dark ms-2">Confidence: @(Model.Confidence.ToString("P0"))</span>
                        <span class="badge bg-info ms-2">@Model.TotalChunksFound chunks found</span>
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="answer-content markdown-body fs-5 lh-lg">
                        @Html.Raw(MarkdownToHtml(Model.Answer))
                    </div>
                </div>
            </div>

            <!-- Sources Card -->
            @if (Model.Sources.Any())
            {
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-header bg-info text-white rounded-4 rounded-bottom-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-book me-2"></i>Source Documents
                            <span class="badge bg-light text-dark ms-2">@Model.Sources.Count documents</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var source in Model.Sources)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <i class="fas fa-file-pdf text-danger me-2"></i>
                                            <strong>@source.FileName</strong>
                                            <span class="badge bg-secondary ms-2">Page @source.PageNumber</span>
                                            <span class="badge bg-info ms-2">Relevance: @(source.RelevanceScore.ToString("P0"))</span>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary" onclick="copyText('@source.Excerpt.Replace("'", "\\'")')">
                                            <i class="fas fa-copy me-1"></i>Copy
                                        </button>
                                    </div>
                                    <p class="mt-2 mb-0 text-muted small">@source.Excerpt</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (Model.TotalChunksFound == 0)
            {
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No relevant information found. Try different keywords or upload more PDFs.
                </div>
            }
        </div>
    </div>
</div>

<script>
    function copyText(text) {
        navigator.clipboard.writeText(text);
        alert('✅ Copied to clipboard!');
    }
</script>

@functions {
    public string MarkdownToHtml(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return "";

        var html = markdown;

        // Headings
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.*?)$", "<h2 class='mt-3 mb-2'>$1</h2>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^### (.*?)$", "<h3 class='mt-2 mb-2 text-info'>$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);

        // Bold
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.*?)\*\*", "<strong>$1</strong>");

        // Bullet points
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^• (.*?)$", "<li>$1</li>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(<li>.*?</li>)", "<ul class='mb-3'>$1</ul>", System.Text.RegularExpressions.RegexOptions.Singleline);

        // Tables
        var tablePattern = @"\|(.+)\|\n\|[-:\s|]+\|\n((?:\|.+\|\n?)+)";
        html = System.Text.RegularExpressions.Regex.Replace(html, tablePattern, match =>
        {
            var headers = match.Groups[1].Value.Split('|').Select(h => h.Trim()).Where(h => !string.IsNullOrEmpty(h));
            var rows = match.Groups[2].Value.Trim().Split('\n');

            var tableHtml = "<table class='table table-bordered table-striped mb-3'>\n<thead class='table-dark'>\n<tr>\n";
            foreach (var header in headers)
            {
                tableHtml += $"<th>{header}</th>\n";
            }
            tableHtml += "</tr>\n</thead>\n<tbody>\n";

            foreach (var row in rows)
            {
                if (!string.IsNullOrWhiteSpace(row))
                {
                    var cells = row.Split('|').Select(c => c.Trim()).Where(c => !string.IsNullOrEmpty(c));
                    tableHtml += "<tr>\n";
                    foreach (var cell in cells)
                    {
                        tableHtml += $"<td>{cell}</td>\n";
                    }
                    tableHtml += "</tr>\n";
                }
            }
            tableHtml += "</tbody>\n</table>\n";
            return tableHtml;
        });

        // Line breaks
        html = html.Replace("\n\n", "</p><p>");
        html = "<div class='markdown-content'>" + html + "</div>";

        return html;
    }
}