@model IEnumerable<UniSmartLMS.Models.SectionC_Catalog.ItemCopy>

@{
    ViewData["Title"] = "Search Books";
}

<div class="container mt-4">
    <h2><i class="fas fa-search me-2"></i>Search Books</h2>
    
    <!-- Search Box -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("SearchBooks")" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control form-control-lg" 
                           placeholder="Search by title, author, ISBN..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Table with Location Details -->
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fas fa-list me-2"></i>Available Books</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Book Title</th>
                            <th>Author</th>
                            <th>ISBN</th>
                            <th>Branch</th>
                            <th>Section</th>
                            <th>Rack (الماری)</th>
                            <th>Shelf (ڈبہ)</th>
                            <th>Status</th>
                            <th class="pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var copy in Model)
                        {
                            var isAvailable = copy.IsActive && copy.Status != "Issued";
                            <tr>
                                <td class="ps-4 fw-bold">@copy.ItemInfo?.Title</td>
                                <td class="text-muted">@copy.ItemInfo?.AuthorItemInfos?.FirstOrDefault()?.Author?.Name</td>
                                <td>@copy.ItemInfo?.ISBN</td>
                                <td>@copy.LibraryBranch?.Name</td>
                                <td>@copy.LibraryRack?.LibraryItemSection?.Name</td>
                                <td>@copy.LibraryRack?.Code</td>
                                <td>@copy.LibraryShelf?.Code</td>
                                <td>
                                    @if (isAvailable) { <span class="badge bg-success">Available</span> }
                                    else { <span class="badge bg-danger">Issued</span> }
                                </td>
                                <td class="pe-4">
                                    @if (isAvailable && User.IsInRole("Student"))
                                    {
                                        <a asp-action="Reserve" asp-route-id="@copy.Id" class="btn btn-sm btn-warning">Reserve</a>
                                    }
                                    else if (isAvailable && User.IsInRole("Visitor"))
                                    {
                                        <a asp-action="Create" asp-controller="BorrowRequest" asp-route-bookId="@copy.ItemInfoId" class="btn btn-sm btn-primary">Request to Borrow</a>
                                    }
                                </td>
                             </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>