@model UniSmartLMS.Models.SectionD_People.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Student Details</h3>
                </div>
                <div class="card-body p-4">
                    <dl class="row">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Registration Number</dt>
                        <dd class="col-sm-8">@Model.RegistrationNumber</dd>

                        <dt class="col-sm-4">Student Name</dt>
                        <dd class="col-sm-8">@Model.Party?.PartyName</dd>

                        <dt class="col-sm-4">Candidate ID</dt>
                        <dd class="col-sm-8">@Model.CandidateId</dd>

                        <dt class="col-sm-4">Degree Program ID</dt>
                        <dd class="col-sm-8">@Model.DegreeProgramId</dd>

                        <dt class="col-sm-4">Degree Level ID</dt>
                        <dd class="col-sm-8">@Model.DegreeLevelId</dd>

                        <dt class="col-sm-4">Quota</dt>
                        <dd class="col-sm-8">@Model.Quota</dd>

                        <dt class="col-sm-4">Timing ID</dt>
                        <dd class="col-sm-8">@Model.TimingId</dd>

                        <dt class="col-sm-4">Program Session ID</dt>
                        <dd class="col-sm-8">@Model.ProgramSessionId</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created At</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
                    </dl>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>