@model IEnumerable<UniSmartLMS.Models.SectionC_Catalog.ItemCopy>
@{
    ViewData["Title"] = "Book Catalog - Staff";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-book me-2"></i>Book Catalog</h2>
            <p class="text-muted">Browse all available books with location details</p>
        </div>
    </div>

    <!-- Search Box -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control form-control-lg" 
                           placeholder="Search by title, author, or ISBN..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Books Table -->
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-success text-white rounded-4 rounded-bottom-0">
            <h5 class="mb-0"><i class="fas fa-list me-2"></i>Available Books</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Author</th>
                            <th>Publisher</th>
                            <th>ISBN</th>
                            <th>Branch</th>
                            <th>Section</th>
                            <th>Rack (الماری)</th>
                            <th>Shelf (ڈبہ)</th>
                            <th>Status</th>
                            <th class="pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var copy in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@copy.ItemInfo?.Title</td>
                                <td>@(copy.ItemInfo?.AuthorItemInfos?.FirstOrDefault()?.Author?.Name ?? "N/A")</td>
                                <td>@(copy.ItemInfo?.PublisherInfo?.Name ?? "N/A")</td>
                                <td>@copy.ItemInfo?.ISBN</td>
                                <td>@copy.LibraryBranch?.Name</td>
                                <td>@copy.LibraryRack?.LibraryItemSection?.Name</td>
                                <td><span class="badge bg-secondary">@copy.LibraryRack?.Code</span></td>
                                <td><span class="badge bg-secondary">@copy.LibraryShelf?.Code</span></td>
                                <td>
                                    @if (copy.IsActive)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Issued</span>
                                    }
                                </td>
                                <td class="pe-4">
                                    <a asp-action="Details" asp-route-id="@copy.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye me-1"></i>Details
                                    </a>
                                    @if (User.IsInRole("Staff"))
                                    {
                                        <a asp-controller="BorrowRequest" asp-action="Create" asp-route-itemCopyId="@copy.Id" class="btn btn-sm btn-primary ms-1">
                                            <i class="fas fa-hand-holding-heart me-1"></i>Request
                                        </a>
                                    }
                                </td>
                                
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>