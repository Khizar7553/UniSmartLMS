@model List<UniSmartLMS.Models.SectionF_Fines.UserFine>
@{
    ViewData["Title"] = "Fine Collection Report";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h4><i class="fas fa-rupee-sign me-2"></i>Fine Collection Report</h4>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <label>From Date</label>
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>To Date</label>
                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>&nbsp;</label>
                    <button type="submit" class="btn btn-danger w-100">Apply Filter</button>
                </div>
            </form>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h5>Total Fine</h5>
                            <h2>Rs. @ViewBag.TotalFine.ToString("N2")</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5>Paid Fine</h5>
                            <h2>Rs. @ViewBag.PaidFine.ToString("N2")</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <h5>Pending Fine</h5>
                            <h2>Rs. @ViewBag.PendingFine.ToString("N2")</h2>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Member</th>
                                <th>Card No.</th>
                                <th>Fine Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fine in Model)
                            {
                                <tr>
                                    <td>@fine.LibraryMember?.Party?.PartyName</td>
                                    <td>@fine.LibraryMember?.CardNo</td>
                                    <td><span class="text-danger">Rs. @fine.FineAccrued.ToString("N2")</span></td>
                                    <td>
                                        @if (fine.IsActive)
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                    </td>
                                    <td>@fine.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>