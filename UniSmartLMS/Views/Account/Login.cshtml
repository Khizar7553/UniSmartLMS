@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white text-center rounded-4 rounded-bottom-0 py-3">
                    <h3 class="mb-0"><i class="fas fa-sign-in-alt me-2"></i>Welcome Back</h3>
                    <p class="mb-0 small opacity-75">Login to UniSmartLMS</p>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" asp-action="Login" asp-route-returnUrl="@returnUrl">
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="fas fa-envelope me-2"></i>Email Address</label>
                            <input type="email" name="email" class="form-control" placeholder="your@email.com" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="fas fa-lock me-2"></i>Password</label>
                            <input type="password" name="password" class="form-control" placeholder="Enter your password" required />
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" />
                            <label class="form-check-label" for="rememberMe">Remember me</label>
                        </div>
                        <div class="text-center mt-3">
                            <a asp-action="ForgotPassword" class="text-decoration-none">Forgot Password?</a>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </button>
                    </form>

                    <hr class="my-4" />
                    <p class="text-center mb-0">
                        Don't have an account? <a asp-action="Register" asp-route-returnUrl="@returnUrl" class="text-success fw-bold">Register here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>