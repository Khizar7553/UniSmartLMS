@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark text-center rounded-4 rounded-bottom-0 py-3">
                    <h3><i class="fas fa-exclamation-triangle me-2"></i>Role Not Assigned</h3>
                </div>
                <div class="card-body text-center p-4">
                    <i class="fas fa-user-clock fa-5x text-warning mb-3"></i>
                    <h4>Welcome, @User.Identity?.Name!</h4>
                    <p class="text-muted">Your account has been created but no role has been assigned yet.</p>
                    <p>Please contact the system administrator to assign your role.</p>
                    <hr />
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-danger ms-2">Logout</a>
                </div>
            </div>
        </div>
    </div>
</div>