@model UniSmartLMS.Models.SectionD_People.LibraryMember

@{
    ViewData["Title"] = "Library Member Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Library Member Details</h3>
                </div>
                <div class="card-body p-4">
                    <dl class="row">
                        <dt class="col-sm-4">Card Number</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@Model.CardNo</span></dd>

                        <dt class="col-sm-4">Member Name</dt>
                        <dd class="col-sm-8">@Model.Party?.PartyName</dd>

                        <dt class="col-sm-4">Library Branch</dt>
                        <dd class="col-sm-8">@Model.LibraryBranch?.Description</dd>

                        <dt class="col-sm-4">Membership Type</dt>
                        <dd class="col-sm-8">
                            @if (Model.MembershipType == 1)
                            {
                                <span>Student</span>
                            }
                            else if (Model.MembershipType == 2)
                            {

                                <span>Faculty</span>
                            }
                            else if (Model.MembershipType == 3)
                            {

                                <span>Staff</span>
                            }
                            else if (Model.MembershipType == 4)
                            {

                                <span>Public</span>
                            }
                            else if (Model.MembershipType == 5)
                            {

                                <span>Researcher</span>
                            }
                            else
                            {

                                <span>Unknown</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Issued On</dt>
                        <dd class="col-sm-8">@Model.IssuedOn.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4">Expired On</dt>
                        <dd class="col-sm-8">@Model.ExpiredOn.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive && Model.ExpiredOn > DateTime.Now)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else if (Model.ExpiredOn <= DateTime.Now)
                            {
                                <span class="badge bg-danger">Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created At</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>
                    </dl>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>