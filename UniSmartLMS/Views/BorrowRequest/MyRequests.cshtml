@model IEnumerable<UniSmartLMS.Models.SectionH_Digital.BorrowRequest>
@{
    ViewData["Title"] = "My Borrow Requests";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-4">
        <h2><i class="fas fa-clock me-2"></i>My Borrow Requests</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New Request</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr><th>Book</th><th>Request Date</th><th>Status</th><th>Admin Response</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ItemCopy?.ItemInfo?.Title</td>
                                <td>@item.RequestDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                                    else if (item.Status == "Approved") { <span class="badge bg-success">Approved - Visit Library</span> }
                                    else { <span class="badge bg-danger">Rejected</span> }
                                </td>
                                <td>@item.AdminRemarks</td>
                               
                                <td>
                                    @if (item.Status == "Approved")
                                    {
                                        <a href="#" class="btn btn-sm btn-success">Visit Library Counter</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
