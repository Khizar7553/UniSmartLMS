@{
    ViewData["Title"] = "Request to Borrow";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white">
                    <h3><i class="fas fa-hand-holding-heart me-2"></i>Request to Borrow Book</h3>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Select Book Copy (Barcode)</label>
                            <select name="itemCopyId" class="form-control" asp-items="ViewBag.CopyList" required>
                                <option value="">-- Select Book --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Remarks (Optional)</label>
                            <textarea name="memberRemarks" class="form-control" rows="3" placeholder="Any specific reason..."></textarea>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Note:</strong> After submitting, visit the library counter with your ID card to complete the borrowing process.
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary px-4"><i class="fas fa-paper-plane me-2"></i>Submit Request</button>
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>