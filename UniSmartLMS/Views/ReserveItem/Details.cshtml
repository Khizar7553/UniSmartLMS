@model UniSmartLMS.Models.SectionE_Circulation.ReserveItem

@{
    ViewData["Title"] = "Reservation Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Reservation Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Book Title</dt>
                                <dd>@Model.ItemInfo?.Title</dd>

                                <dt>Member Card</dt>
                                <dd>@Model.LibraryMember?.CardNo</dd>

                                <dt>Hold Duration</dt>
                                <dd>@Model.Duration?.Name</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Number Duration</dt>
                                <dd>@Model.NumberDuration</dd>

                                <dt>Expiry Date</dt>
                                <dd>@Model.ExpiryDate.ToString("dd MMM yyyy")</dd>

                                <dt>Available for Pickup</dt>
                                <dd>@(Model.IsAvailable ? "Yes" : "No")</dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>