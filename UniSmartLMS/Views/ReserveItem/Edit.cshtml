@model UniSmartLMS.Models.SectionE_Circulation.ReserveItem

@{
    ViewData["Title"] = "Edit Reservation";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Reservation</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ItemInfoId" class="form-label fw-bold">Book</label>
                                <select asp-for="ItemInfoId" class="form-control" asp-items="ViewBag.ItemList">
                                    <option value="">-- Select Book --</option>
                                </select>
                                <span asp-validation-for="ItemInfoId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LibraryMemberId" class="form-label fw-bold">Member</label>
                                <select asp-for="LibraryMemberId" class="form-control" asp-items="ViewBag.MemberList">
                                    <option value="">-- Select Member --</option>
                                </select>
                                <span asp-validation-for="LibraryMemberId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="DurationId" class="form-label fw-bold">Hold Duration</label>
                                <select asp-for="DurationId" class="form-control" asp-items="ViewBag.DurationList">
                                    <option value="">-- Select Duration --</option>
                                </select>
                                <span asp-validation-for="DurationId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="NumberDuration" class="form-label fw-bold">Number Duration</label>
                                <input asp-for="NumberDuration" class="form-control" />
                                <span asp-validation-for="NumberDuration" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="ExpiryDate" class="form-label fw-bold">Expiry Date</label>
                                <input asp-for="ExpiryDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="IsAvailable" class="form-check-input" />
                                    <label asp-for="IsAvailable" class="form-check-label fw-bold">Available for Pickup</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                                </div>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-warning px-4"><i class="fas fa-save me-2"></i>Save</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}