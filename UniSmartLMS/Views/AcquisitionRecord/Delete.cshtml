@model UniSmartLMS.Models.SectionG_Acquisitions.AcquisitionRecord

@{
    ViewData["Title"] = "Delete Acquisition Record";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 border-danger">
                <div class="card-header bg-danger text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-trash-alt me-2"></i>Delete Acquisition Record</h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning!</strong> This action cannot be undone.
                    </div>
                    <dl class="row">
                        <dt class="col-sm-4">Transaction Type</dt>
                        <dd class="col-sm-8">@Model.Type</dd>

                        <dt class="col-sm-4">Vendor / Party</dt>
                        <dd class="col-sm-8">@Model.Party?.PartyName</dd>

                        <dt class="col-sm-4">Invoice Number</dt>
                        <dd class="col-sm-8">@Model.Invoice</dd>

                        <dt class="col-sm-4">Amount</dt>
                        <dd class="col-sm-8">Rs. @Model.Amount.ToString("N2")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
                    </dl>
                    <hr />
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-danger px-4"><i class="fas fa-trash-alt me-2"></i>Confirm Delete</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
