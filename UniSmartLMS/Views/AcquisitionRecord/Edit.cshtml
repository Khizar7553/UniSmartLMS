@model UniSmartLMS.Models.SectionG_Acquisitions.AcquisitionRecord

@{
    ViewData["Title"] = "Edit Acquisition Record";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Acquisition Record</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Type" class="form-label fw-bold">Transaction Type</label>
                                <select asp-for="Type" class="form-control">
                                    <option value="">-- Select Type --</option>
                                    <option value="Purchase">Purchase</option>
                                    <option value="Donation">Donation</option>
                                    <option value="Exchange">Exchange</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PartyId" class="form-label fw-bold">Vendor / Party</label>
                                <select asp-for="PartyId" class="form-control" asp-items="ViewBag.PartyList">
                                    <option value="">-- Select Party --</option>
                                </select>
                                <span asp-validation-for="PartyId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Invoice" class="form-label fw-bold">Invoice Number</label>
                                <input asp-for="Invoice" class="form-control" />
                                <span asp-validation-for="Invoice" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Date" class="form-label fw-bold">Transaction Date</label>
                                <input asp-for="Date" type="date" class="form-control" />
                                <span asp-validation-for="Date" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-bold">Amount</label>
                            <input asp-for="Amount" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-warning px-4"><i class="fas fa-save me-2"></i>Save</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}