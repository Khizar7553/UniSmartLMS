@model UniSmartLMS.Models.SectionA_University.Position

@{
    ViewData["Title"] = "Delete Position";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4 border-danger">
                <div class="card-header bg-danger text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-trash-alt me-2"></i>Delete Position</h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning!</strong> This action cannot be undone.
                    </div>
                    <dl class="row">
                        <dt class="col-sm-3">Category</dt>
                        <dd class="col-sm-9">@Model.Category</dd>

                        <dt class="col-sm-3">Code</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Code</span></dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.Description</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
                    </dl>
                    <hr />
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-danger px-4"><i class="fas fa-trash-alt me-2"></i>Confirm Delete</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>