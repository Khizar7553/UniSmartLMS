@model IEnumerable<UniSmartLMS.Models.SectionD_People.Party>

@{
    ViewData["Title"] = "Parties";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-success">
                <i class="fas fa-users me-3"></i>Parties
            </h1>
            <p class="text-muted">Manage all persons (Students, Faculty, Staff, Public)</p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-lg shadow">
            <i class="fas fa-plus-circle me-2"></i>Add New Party
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Box -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Search" method="get" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control form-control-lg"
                           placeholder="Search by name or email..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-success text-white rounded-4 rounded-bottom-0">
            <i class="fas fa-list me-2"></i> Parties List
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Contact</th>
                            <th>Position</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">@item.Id</td>
                                <td class="fw-bold">@item.PartyName</td>
                                <td>@item.Email</td>
                                <td>@item.PartyContact</td>
                                <td>@item.Position?.Category</td>
                                <td>
                                    @if (item.PartyTypeId == 1)
                                    {
                                        <span class="badge bg-primary">Student</span>
                                    }
                                    else if (item.PartyTypeId == 2)
                                    {

                                        <span class="badge bg-info">Faculty</span>
                                    }
                                    else if (item.PartyTypeId == 3)
                                    {

                                        <span class="badge bg-secondary">Staff</span>
                                    }
                                    else if (item.PartyTypeId == 4)
                                    {

                                        <span class="badge bg-warning">Librarian</span>
                                    }
                                    else if (item.PartyTypeId == 5)
                                    {

                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else if (item.PartyTypeId == 6)
                                    {

                                        <span class="badge bg-dark text-white">Visitor</span>
                                    }
                                    else if (item.PartyTypeId == 7)
                                    {

                                        <span class="badge bg-success">Vendor</span>
                                    }
                                    else if (item.PartyTypeId == 8)
                                    {

                                        <span class="badge bg-info">Author</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-light text-dark">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash-alt"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>