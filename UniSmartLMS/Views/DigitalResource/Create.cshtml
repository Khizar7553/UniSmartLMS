@model UniSmartLMS.Models.SectionH_Digital.DigitalResource

@{
    ViewData["Title"] = "Add Digital Resource";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add Digital Resource</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ItemInfoId" class="form-label fw-bold">Book</label>
                                <select asp-for="ItemInfoId" class="form-control" asp-items="ViewBag.ItemList">
                                    <option value="">-- Select Book --</option>
                                </select>
                                <span asp-validation-for="ItemInfoId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FileFormat" class="form-label fw-bold">File Format</label>
                                <select asp-for="FileFormat" class="form-control">
                                    <option value="">-- Select Format --</option>
                                    <option value="PDF">PDF</option>
                                    <option value="EPUB">EPUB</option>
                                    <option value="MOBI">MOBI</option>
                                    <option value="MP4">MP4</option>
                                    <option value="MP3">MP3</option>
                                </select>
                                <span asp-validation-for="FileFormat" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FilePath" class="form-label fw-bold">File Path</label>
                                <input asp-for="FilePath" class="form-control" placeholder="/uploads/books/sample.pdf" />
                                <span asp-validation-for="FilePath" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FileSizeMb" class="form-label fw-bold">File Size (MB)</label>
                                <input asp-for="FileSizeMb" class="form-control" placeholder="e.g., 5.5" />
                                <span asp-validation-for="FileSizeMb" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TotalDownloads" class="form-label fw-bold">Total Downloads</label>
                            <input asp-for="TotalDownloads" class="form-control" placeholder="0" />
                            <span asp-validation-for="TotalDownloads" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Note:</strong> File will be stored in the specified path. Ensure the directory exists.
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-2"></i>Add Resource</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}