@model UniSmartLMS.Models.SectionE_Circulation.ItemRequisition

@{
    ViewData["Title"] = "Create Requisition";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-plus-circle me-2"></i>New Item Requisition</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ItemInfoId" class="form-label fw-bold">Book</label>
                                <select asp-for="ItemInfoId" class="form-control" asp-items="ViewBag.ItemList">
                                    <option value="">-- Select Book --</option>
                                </select>
                                <span asp-validation-for="ItemInfoId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LibraryBranchId" class="form-label fw-bold">Library Branch</label>
                                <select asp-for="LibraryBranchId" class="form-control" asp-items="ViewBag.BranchList">
                                    <option value="">-- Select Branch --</option>
                                </select>
                                <span asp-validation-for="LibraryBranchId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Quantity" class="form-label fw-bold">Quantity</label>
                                <input asp-for="Quantity" class="form-control" placeholder="e.g., 5" />
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="LibraryRackId" class="form-label fw-bold">Rack (Almari)</label>
                                <select asp-for="LibraryRackId" class="form-control" asp-items="ViewBag.RackList">
                                    <option value="">-- Select Rack --</option>
                                </select>
                                <span asp-validation-for="LibraryRackId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="EstimateCost" class="form-label fw-bold">Estimated Cost (PKR)</label>
                                <input asp-for="EstimateCost" class="form-control" placeholder="e.g., 5000" />
                                <span asp-validation-for="EstimateCost" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-2"></i>Create Requisition</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}