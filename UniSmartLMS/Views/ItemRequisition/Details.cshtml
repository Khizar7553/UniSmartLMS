@model UniSmartLMS.Models.SectionE_Circulation.ItemRequisition

@{
    ViewData["Title"] = "Requisition Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Requisition Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Book Title</dt>
                                <dd>@Model.ItemInfo?.Title</dd>

                                <dt>Book ISBN</dt>
                                <dd>@Model.ItemInfo?.ISBN</dd>

                                <dt>Library Branch</dt>
                                <dd>@Model.LibraryBranch?.Description</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Rack (Almari)</dt>
                                <dd>@Model.LibraryRack?.Code</dd>

                                <dt>Quantity</dt>
                                <dd>@Model.Quantity</dd>

                                <dt>Estimated Cost</dt>
                                <dd>Rs. @Model.EstimateCost.ToString("N2")</dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>