@model UniSmartLMS.Models.SectionB_Library.LibraryShelf

@{
    ViewData["Title"] = "Create Library Shelf";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add New Library Shelf</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label fw-bold">Shelf Code</label>
                            <input asp-for="Code" class="form-control" placeholder="e.g., SH-01" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LibraryRackId" class="form-label fw-bold">Rack</label>
                            <select asp-for="LibraryRackId" class="form-control" asp-items="ViewBag.RackList">
                                <option value="">-- Select Rack --</option>
                            </select>
                            <span asp-validation-for="LibraryRackId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaxCapacity" class="form-label fw-bold">Max Capacity (Books)</label>
                            <input asp-for="MaxCapacity" class="form-control" placeholder="e.g., 100" />
                            <span asp-validation-for="MaxCapacity" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NoOfItems" class="form-label fw-bold">Current Items</label>
                            <input asp-for="NoOfItems" class="form-control" placeholder="e.g., 45" />
                            <span asp-validation-for="NoOfItems" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-2"></i>Create</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="fas fa-arrow-left me-2"></i>Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}