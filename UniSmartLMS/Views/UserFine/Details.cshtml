@model UniSmartLMS.Models.SectionF_Fines.UserFine

@{
    ViewData["Title"] = "User Fine Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-4 rounded-bottom-0">
                    <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>User Fine Details</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Member Card</dt>
                                <dd>@Model.LibraryMember?.CardNo</dd>

                                <dt>Fine Definition ID</dt>
                                <dd>@Model.FineDefinitionId</dd>

                                <dt>Fine Allocation ID</dt>
                                <dd>@Model.FineAllocationId</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Tax % Per Day</dt>
                                <dd>@Model.TaxPercentagePerDay.ToString("N2")%</dd>

                                <dt>Fine Accrued</dt>
                                <dd>Rs. @Model.FineAccrued.ToString("N2")</dd>

                                <dt>Book Barcode</dt>
                                <dd>@Model.ItemCopy?.Barcode</dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-2"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>